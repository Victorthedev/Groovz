# Copy this to deploy/.env on the VM and fill in real values.
# NEVER commit deploy/.env — it's already covered by .dockerignore's **/.env rule,
# make sure it's also in .gitignore.

# ─── Core ─────────────────────────────────────────────────────────────────────
JWT_SECRET=""            # reuse Railway's value, or generate fresh: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""  # reuse Railway's value — changing this orphans any existing encrypted tokens
NODE_ENV="production"

# ─── URLs ─────────────────────────────────────────────────────────────────────
API_BASE_URL="https://groovz-api.duckdns.org"
WEB_BASE_URL=""          # your Vercel URL, e.g. https://groovz.vercel.app

# ─── Database ─────────────────────────────────────────────────────────────────
# Neon connection string (REDIS_URL is set separately in docker-compose.yml, don't add it here)
DATABASE_URL=""

# ─── Music APIs ───────────────────────────────────────────────────────────────
LASTFM_API_KEY=""

# ─── AI ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=""
HUGGINGFACE_API_KEY=""

# ─── Spotify ──────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# ─── Deezer ───────────────────────────────────────────────────────────────────
DEEZER_APP_ID=""
DEEZER_APP_SECRET=""

# ─── YouTube Music ────────────────────────────────────────────────────────────
YOUTUBE_MUSIC_CLIENT_ID=""
YOUTUBE_MUSIC_CLIENT_SECRET=""

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_NG=""
STRIPE_PRICE_UK=""
STRIPE_PRICE_EU=""
STRIPE_PRICE_US=""
STRIPE_PRICE_CA=""

# ─── Admin ────────────────────────────────────────────────────────────────────
OWNER_EMAIL=""
